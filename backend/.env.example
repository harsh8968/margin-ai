# Copy to backend/.env and fill in. This file is read by the backend only; the browser never sees the key.
GEMINI_API_KEY=
# Free-tier models (Oct 2026). The fallback is used automatically on rate limits / overload.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# "gemini" (default) or "mock" (keyword-matching stand-in for UI work without a key)
LLM_PROVIDER=gemini

# Voice tutor (Gemini Live). The browser gets a single-use token, never the key.
VOICE_MODEL=gemini-3.8-live
VOICE_NAME=Kore
